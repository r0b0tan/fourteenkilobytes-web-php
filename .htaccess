# fourteenkilobytes - Apache Configuration
# This file must be in the root of your web directory

# Disable directory listing
Options -Indexes

# Deny access to sensitive files. JSON is denied by name only: the admin's
# translations (/lang/*.json -> public/lang/) must stay reachable.
<FilesMatch "\.(bak|backup|md|log|sh|lock|dist|example)$|^(composer|package|package-lock|version)\.json$|^\.">
    Require all denied
</FilesMatch>

# Behind a reverse proxy (load balancer, CDN, Docker), list its addresses so rate limiting
# and audit logs see the real client IP from X-Forwarded-For:
# SetEnv FKB_TRUSTED_PROXIES "172.16.0.0/12"

RewriteEngine On

# Allow access to new public language files
RewriteRule ^lang/(.*)$ public/lang/$1 [L]

# Deny access to data directory
RewriteRule ^data/ - [F,L]

# Redirect to setup wizard if not completed (except setup, api, and static files)
RewriteCond %{REQUEST_URI} !^/setup
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/data/.setup-complete !-f
RewriteRule ^.*$ /setup/ [R=302,L]

# Setup wizard routing
RewriteRule ^setup/api\.php/(.*)$ setup/api.php [L,QSA,E=PATH_INFO:/$1]
RewriteRule ^setup/?$ setup/index.php [L]

# API requests -> /api/index.php
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# Admin static files (pass through if file exists)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^public/admin/.*$ - [L]

# Admin routes - prevent indexing, restrict what the admin pages may load
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/admin" ADMIN_REQ
    Header set X-Robots-Tag "noindex, nofollow" env=ADMIN_REQ
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" env=ADMIN_REQ
    # After the internal rewrite to public/admin/ the variable carries a REDIRECT_ prefix
    Header set X-Robots-Tag "noindex, nofollow" env=REDIRECT_ADMIN_REQ
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" env=REDIRECT_ADMIN_REQ
    Header set X-Frame-Options "DENY" env=REDIRECT_ADMIN_REQ
    Header set X-Content-Type-Options "nosniff" env=REDIRECT_ADMIN_REQ

    # HSTS: enable only once HTTPS works for this host (and all subdomains if you add includeSubDomains)
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Redirect /admin to /admin/index.html to fix relative path issues
RewriteRule ^admin/?$ /admin/index.html [R=301,L]
RewriteRule ^admin/index.html$ public/admin/index.html [L]
RewriteRule ^admin/(.+)$ public/admin/$1 [L]

# Static files in public (pass through if exists)
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} -f
RewriteRule ^ - [L]

# RSS Feed
RewriteRule ^feed\.xml$ feed.php [L]

# Root -> public/index.html or index.php router
RewriteRule ^$ index.php [L]

# Redirect .html slug URLs to clean URLs
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

# Blog posts (slug format) -> index.php router
RewriteRule ^([a-z0-9-]+)/?$ index.php?slug=$1 [L,QSA]
